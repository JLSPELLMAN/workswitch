{
  "manifest_version": 3,
  "name": "WorkSwitch Tab Bridge",
  "version": "0.2.0",
  "description": "Sends Chrome tab metadata to the WorkSwitch macOS app so tabs appear in the switcher.",
  "key": "",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
